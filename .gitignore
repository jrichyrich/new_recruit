!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.certification/

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
