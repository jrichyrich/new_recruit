{
  "name": "rosterpilot",
  "version": "0.2.0",
  "private": true,
  "description": "Build, inspect, modify, validate, explain, export, and optionally analyze Warhammer 40,000 army rosters.",
  "bin": {
    "rosterpilot": "./bin/rosterpilot.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/setup.mjs --doctor",
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "node --import tsx --test tests/*.test.ts && npm run build && node --test tests/rendered-html.test.mjs",
    "verify": "npm run lint && npm test && npm run tessera:engine:check && npm run data:sync-check && npm run certify:manifest:check && npm run plugin:check",
    "certify": "node --import tsx scripts/certify.ts",
    "certify:deterministic": "npm run certify -- --tier deterministic",
    "certify:connector": "npm run certify -- --tier connector",
    "certify:live": "npm run certify -- --tier live",
    "certify:canary": "node --import tsx scripts/live-canary.ts",
    "certify:provider-compatibility": "node --import tsx scripts/provider-compatibility-rollout.ts",
    "certify:provider-parity": "node --import tsx scripts/certify-live-numerical-parity.ts",
    "certify:provider-parity-rollout": "node --import tsx scripts/live-numerical-parity-rollout.ts",
    "data:rollback-after-canary": "node --import tsx scripts/rollback-data-bundle-after-canary.ts",
    "certify:trend": "node --import tsx scripts/certification-trend.ts",
    "certify:manifest:check": "node --import tsx scripts/sync-certification-manifest.ts --check",
    "certify:manifest:sync": "node --import tsx scripts/sync-certification-manifest.ts --write",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "rosterpilot": "node --import tsx cli/rosterpilot.ts",
    "mcp": "node --import tsx mcp/stdio.ts",
    "tessera:engine:check": "node scripts/verify-tessera-engine-provenance.mjs",
    "companion:build": "node scripts/build-new-recruit-companion.mjs",
    "data:check": "node --import tsx scripts/check-roster-data.ts",
    "data:check-latest": "node --import tsx scripts/check-roster-data.ts --latest",
    "data:prepare-update": "node --import tsx scripts/prepare-data-bundle-update.ts",
    "data:bundle:build": "node --import tsx scripts/build-data-bundle.ts",
    "data:bundle:prepare-release": "node --import tsx scripts/prepare-data-bundle-release.ts",
    "data:bundle:verify-release": "node --import tsx scripts/verify-data-bundle-release.ts",
    "data:publisher:check": "node --import tsx scripts/check-data-publisher-config.ts",
    "data:official-overlay": "node --import tsx scripts/official-data-overlay.ts",
    "data:legends:discover": "node --import tsx scripts/discover-gw-faction-packs.ts",
    "data:legends:extract": "node --import tsx scripts/extract-gw-legends-faction-pack.ts",
    "data:prepare-update:legacy-direct-sync": "node --import tsx scripts/prepare-data-update.ts",
    "data:sync": "node --import tsx scripts/sync-bsdata.ts --write",
    "data:sync-check": "node --import tsx scripts/sync-bsdata.ts --check",
    "build:release": "npm run data:bundle:verify-release && npm run build",
    "skill:install": "node scripts/manage-rosterpilot-skill.mjs",
    "skill:check": "node scripts/manage-rosterpilot-skill.mjs --check",
    "plugin:sync": "node scripts/sync-rosterpilot-plugin.mjs",
    "plugin:check": "node scripts/sync-rosterpilot-plugin.mjs",
    "plugin:local:install": "node scripts/manage-rosterpilot-personal-plugin.mjs",
    "plugin:local:check": "node scripts/manage-rosterpilot-personal-plugin.mjs --check",
    "fixtures:sanitize": "node --import tsx scripts/sanitize-new-recruit-fixtures.ts",
    "fixtures:record-connector": "node --import tsx scripts/record-connector-fixture.ts"
  },
  "dependencies": {
    "@alpaca-software/40kdc-data": "1.2.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "chromium-bidi": "5.3.1",
    "drizzle-orm": "0.45.2",
    "fflate": "^0.8.2",
    "next": "16.2.6",
    "playwright-core": "^1.54.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tessera-engine": "https://codeload.github.com/Tessera-cmd/tessera-engine/tar.gz/16ab4365bbd97ef592b061c5a9babe5e44f00e80",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
